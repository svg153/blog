---
import Layout from '@layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { buildTaxonomy } from '../../lib/taxonomy.mjs';

const taxonomy = buildTaxonomy(await getCollection('blog'));
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<Layout title="Tags" description="Explora los artículos del blog por tema.">
  <section class="taxonomy-page">
    <header class="page-header">
      <h1>Tags</h1>
      <p>Los temas que aparecen en los artículos, normalizados a una URL estable.</p>
    </header>

    <div class="tag-grid">
      {taxonomy.map((entry) => (
        <a
          class="tag-card"
          href={`${base}tags/${entry.slug}/`}
          data-tag-index-slug={entry.slug}
          data-count={entry.posts.length}
        >
          <span class="tag-name">{entry.label}</span>
          <span class="tag-count">
            {entry.posts.length} {entry.posts.length === 1 ? 'artículo' : 'artículos'}
          </span>
        </a>
      ))}
    </div>
  </section>
</Layout>

<style>
  .page-header {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .page-header p {
    color: var(--color-text-secondary);
  }

  .tag-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 0.9rem;
  }

  .tag-card {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    min-width: 0;
    padding: 1rem;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: var(--color-bg-secondary);
    text-decoration: none;
  }

  .tag-card:hover,
  .tag-card:focus-visible {
    border-color: var(--color-accent);
    text-decoration: none;
  }

  .tag-name {
    color: var(--color-heading);
    font-weight: 650;
    overflow-wrap: anywhere;
  }

  .tag-count {
    color: var(--color-text-secondary);
    font-size: 0.85rem;
  }
</style>
