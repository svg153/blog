---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import PostLayout from '@layouts/PostLayout.astro';
import { buildSeries, seriesContextForPost } from '../../lib/series.mjs';
import { getPublishedPosts, readingTimeForPost } from '../../lib/content-lifecycle.mjs';
import { relatedPostsFor } from '../../lib/related-posts.mjs';

export async function getStaticPaths() {
  const posts = getPublishedPosts(await getCollection('blog'));
  const seriesGroups = buildSeries(posts);

  return posts.map((post) => ({
    params: { slug: post.id },
    props: {
      post,
      seriesContext: seriesContextForPost(seriesGroups, post),
      related: relatedPostsFor(post, posts),
    },
  }));
}

interface SeriesLink {
  slug: string;
  title: string;
}

interface SeriesContext {
  id: string;
  name: string;
  order: number;
  position: number;
  total: number;
  previous?: SeriesLink;
  next?: SeriesLink;
}

interface RelatedEntry {
  post: CollectionEntry<'blog'>;
  sameSeries: boolean;
  sharedTagCount: number;
  sharedTags: string[];
}

interface Props {
  post: CollectionEntry<'blog'>;
  seriesContext?: SeriesContext;
  related?: RelatedEntry[];
}

const { post, seriesContext, related = [] } = Astro.props;
const { Content, headings } = await render(post);
const articleHeadings = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const readingTime = readingTimeForPost(post);
---

<PostLayout
  slug={post.id}
  title={post.data.title}
  description={post.data.description}
  date={post.data.date}
  updatedDate={post.data.updatedDate}
  tags={post.data.tags}
  readingTime={readingTime}
  headings={articleHeadings}
  series={seriesContext}
  related={related}
>
  <Content />
</PostLayout>
