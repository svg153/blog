---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import Layout from '@layouts/Layout.astro';
import { buildSeries } from '../../lib/series.mjs';
import { postSlug } from '../../lib/taxonomy.mjs';

export async function getStaticPaths() {
  const groups = buildSeries(await getCollection('blog'));
  return groups.map((group) => ({
    params: { series: group.id },
    props: { group },
  }));
}

interface Props {
  group: {
    id: string;
    name: string;
    posts: CollectionEntry<'blog'>[];
  };
}

const { group } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<Layout
  title={`Serie: ${group.name}`}
  description={`Artículos de la serie ${group.name}, en orden de lectura.`}
>
  <section class="series-page" data-series-page-id={group.id}>
    <header class="page-header">
      <p class="back-link"><a href={`${base}series/`}>← Todas las series</a></p>
      <h1>{group.name}</h1>
      <p>{group.posts.length} {group.posts.length === 1 ? 'artículo' : 'artículos'} en orden de lectura.</p>
    </header>

    <ol class="series-list">
      {group.posts.map((post) => (
        <li
          class="series-entry"
          data-series-post={postSlug(post.id)}
          data-series-order={post.data.series?.order}
        >
          <span class="order">{post.data.series?.order}</span>
          <div>
            <a href={`${base}posts/${postSlug(post.id)}/`}>{post.data.title}</a>
            {post.data.description && <p>{post.data.description}</p>}
          </div>
        </li>
      ))}
    </ol>
  </section>
</Layout>

<style>
  .page-header { margin-bottom: 2rem; padding-bottom: 1.5rem; border-bottom: 1px solid var(--color-border); }
  .page-header p, .back-link { color: var(--color-text-secondary); }
  .back-link { font-size: 0.9rem; margin-bottom: 0.75rem; }
  .series-list { list-style: none; margin: 0; padding: 0; }
  .series-entry { display: grid; grid-template-columns: 2.5rem minmax(0, 1fr); gap: 1rem; padding: 1rem 0; border-bottom: 1px solid var(--color-border); }
  .series-entry .order { display: inline-flex; align-items: center; justify-content: center; width: 2rem; height: 2rem; border: 1px solid var(--color-border); border-radius: 9999px; color: var(--color-text-secondary); font-size: 0.85rem; }
  .series-entry a { color: var(--color-heading); font-weight: 650; }
  .series-entry p { margin: 0.35rem 0 0; color: var(--color-text-secondary); font-size: 0.9rem; }
</style>
