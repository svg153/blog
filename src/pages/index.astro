---
import Layout from '@layouts/Layout.astro';
import PostCard from '../components/PostCard.astro';
import { SITE } from '@config';
import { getCollection } from 'astro:content';
import { sortPostsNewestFirst } from '../lib/taxonomy.mjs';
import { getPublishedPosts } from '../lib/content-lifecycle.mjs';

const sortedPosts = sortPostsNewestFirst(getPublishedPosts(await getCollection('blog')));
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<Layout title="Blog" description={SITE.description}>
  <div class="blog-home">
    <header class="blog-hero">
      <h1>Blog</h1>
      <p class="hero-subtitle">
        Opiniones, tutoriales y reflexiones sobre desarrollo, herramientas y tecnología.
        Escritos por <strong>Sergio Valverde</strong> desde Madrid.
      </p>
      <p class="browse-links">
        <a href={`${base}tags/`}>Explorar por tags</a>
        <span aria-hidden="true">·</span>
        <a href={`${base}archive/`}>Ver archivo cronológico</a>
      </p>
    </header>

    <div class="post-list">
      {sortedPosts.map((post) => <PostCard post={post} />)}
    </div>

    <footer class="blog-footer">
      <p>
        También publico en{' '}
        <a href="https://dev.to/svg153" target="_blank" rel="noopener">dev.to</a>{' '}
        y{' '}
        <a href="https://linkedin.com/in/svg153" target="_blank" rel="noopener">LinkedIn</a>.
      </p>
    </footer>
  </div>
</Layout>

<style>
  .blog-hero {
    text-align: center;
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--color-border);
  }

  .blog-hero h1 {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
  }

  .hero-subtitle {
    color: var(--color-text-secondary);
    font-size: 1.1rem;
    max-width: 600px;
    margin: 0 auto;
  }

  .browse-links {
    margin-top: 1rem;
    margin-bottom: 0;
    display: flex;
    justify-content: center;
    gap: 0.65rem;
    flex-wrap: wrap;
    font-size: 0.9rem;
  }

  .post-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .blog-footer {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
    text-align: center;
    color: var(--color-text-secondary);
    font-size: 0.9rem;
  }

  @media (max-width: 640px) {
    .blog-hero h1 { font-size: 1.8rem; }
    .hero-subtitle { font-size: 1rem; }
  }
</style>
