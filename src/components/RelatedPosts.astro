---
import type { CollectionEntry } from 'astro:content';
import { postSlug } from '../lib/taxonomy.mjs';

export interface RelatedEntry {
  post: CollectionEntry<'blog'>;
  sameSeries: boolean;
  sharedTagCount: number;
}

export interface Props {
  entries?: RelatedEntry[];
}

const { entries = [] } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const formatDate = (date: string) =>
  new Intl.DateTimeFormat('es-ES', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
    timeZone: 'UTC',
  }).format(new Date(`${date}T12:00:00Z`));

const reasonFor = (entry: RelatedEntry) => {
  if (entry.sameSeries) return 'Misma serie';
  if (entry.sharedTagCount === 1) return '1 tag en común';
  if (entry.sharedTagCount > 1) return `${entry.sharedTagCount} tags en común`;
  return 'Lectura reciente';
};
---

{entries.length > 0 && (
  <aside class="related-posts" aria-labelledby="related-posts-title" data-related-posts>
    <div class="related-heading">
      <p class="eyebrow">Sigue leyendo</p>
      <h2 id="related-posts-title">Artículos relacionados</h2>
    </div>

    <div class="related-grid">
      {entries.map((entry) => {
        const slug = postSlug(entry.post.id);
        return (
          <article
            class="related-card"
            data-related-post={slug}
            data-related-same-series={entry.sameSeries ? 'true' : 'false'}
            data-related-shared-tags={entry.sharedTagCount}
          >
            <p class="related-reason">{reasonFor(entry)}</p>
            <h3>
              <a href={`${base}posts/${slug}/`}>{entry.post.data.title}</a>
            </h3>
            <time datetime={entry.post.data.date}>{formatDate(entry.post.data.date)}</time>
          </article>
        );
      })}
    </div>
  </aside>
)}

<style>
  .related-posts {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }

  .related-heading {
    margin-bottom: 1rem;
  }

  .related-heading h2 {
    margin: 0;
    font-size: 1.25rem;
  }

  .eyebrow {
    margin: 0 0 0.25rem;
    color: var(--color-text-secondary);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.9rem;
  }

  .related-card {
    min-width: 0;
    padding: 1rem;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: var(--color-bg-secondary);
  }

  .related-card:hover {
    border-color: var(--color-accent);
  }

  .related-reason {
    margin: 0 0 0.45rem;
    color: var(--color-accent);
    font-size: 0.75rem;
    font-weight: 650;
  }

  .related-card h3 {
    margin: 0 0 0.65rem;
    font-size: 1rem;
    line-height: 1.35;
  }

  .related-card h3 a {
    color: var(--color-heading);
    text-decoration: none;
  }

  .related-card h3 a:hover,
  .related-card h3 a:focus-visible {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .related-card time {
    color: var(--color-text-secondary);
    font-size: 0.8rem;
  }

  @media (max-width: 760px) {
    .related-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
